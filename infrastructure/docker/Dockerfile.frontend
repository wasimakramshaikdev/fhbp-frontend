# Multi-stage build for React frontend
FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./
RUN npm run build

# Production Nginx Stage
FROM nginx:alpine

# Copy built React static files to Nginx default folder
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY infrastructure/nginx/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Create directories so Nginx can access shared volumes for static/media files
RUN mkdir -p /app/static /app/media

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]